rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 保存したレシピ。本人だけが読み書きできる。ドキュメントIDはレシピのid
    match /users/{uid}/saves/{recipeId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && recipeId.matches('^[a-z0-9-]{1,60}$')
        && request.resource.data.keys().hasOnly(['savedAt'])
        && request.resource.data.savedAt == request.time;
    }

    // お問い合わせ（contact.html、2026-10-09）。誰でも送れるが、読む・直す・消すのはコンソールからだけ
    match /inquiries/{id} {
      allow read, update, delete: if false;
      allow create: if request.resource.data.keys().hasOnly(['category', 'name', 'email', 'message', 'createdAt'])
        && request.resource.data.keys().hasAll(['category', 'email', 'message', 'createdAt'])
        && request.resource.data.category in ['recipe', 'bug', 'account', 'business', 'other']
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+[.][^@\\s]+$')
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 10
        && request.resource.data.message.size() <= 2000
        && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() <= 50))
        && request.resource.data.createdAt == request.time;
    }

    // 会員登録導線の計測（2026-10-11）。段階（表示・クリック・完了）だけを記録し、個人情報は入れない。
    // inquiriesと同じく、誰でも書けるが読む・直す・消すのはコンソールからだけ
    match /funnel_events/{id} {
      allow read, update, delete: if false;
      allow create: if request.resource.data.keys().hasOnly(['step', 'method', 'context', 'createdAt'])
        && request.resource.data.keys().hasAll(['step', 'createdAt'])
        && request.resource.data.step in ['save_prompt_shown', 'auth_click', 'auth_complete']
        && (!('method' in request.resource.data) || request.resource.data.method in ['google', 'email'])
        && (!('context' in request.resource.data) || (request.resource.data.context is string && request.resource.data.context.size() <= 30))
        && request.resource.data.createdAt == request.time;
    }
  }
}
